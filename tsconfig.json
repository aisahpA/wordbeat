{
	"compilerOptions": {
		"resolveJsonModule": true,
		"jsx": "react",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"skipLibCheck": true,
		"allowJs": true,
		"noEmit": true,
		"noImplicitAny": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		// TS 6.0+ no longer auto-includes every @types package; tests run on
		// Node and need its globals (process, node:assert).
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"isolatedModules": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES2021"],
		"typeRoots": ["./node_modules/@types", "./node_modules/obsidian"]
	},
	"include": ["**/*.ts", "**/*.tsx", "*.d.ts"]
}
