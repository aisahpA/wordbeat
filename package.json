{
  "name": "wordbeat",
  "version": "1.0.2",
  "description": "Track your daily writing with a heatmap, goals and streaks.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.js --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.js production",
    "test": "node tests/run.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "reload": "bash reload.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-transition-group": "^4.4.12",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "obsidian": "latest",
    "prettier": "^3.4.2",
    "tslib": "2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.3",
    "jsep": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-transition-group": "^4.4.5",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true
  }
}
